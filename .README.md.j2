{# ---- Helper macros ---- #}

{# Normalize Python booleans/None to yaml-style strings for display #}
{% macro fmt_default(val) %}
{%- if val is none %}null
{%- elif val is sameas true %}true
{%- elif val is sameas false %}false
{%- elif val is string %}{{ val }}
{%- elif val == [] %}[]
{%- else %}{{ val }}
{%- endif %}
{%- endmacro %}

{# Format type + elements + required as inline string #}
{% macro fmt_type(details) %}
`{{ details.get('type', 'raw') }}`
{%- if details.get('elements') %} / `{{ details['elements'] }}`{% endif %}
{%- if details.get('required') %} / required{% endif %}
{%- endmacro %}

{# Format metadata line: choices, default - all on one line #}
{% macro fmt_meta(details) %}
{%- if details.get('choices') %}Choices: {% for c in details['choices'] %}`{{ c }}`{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}
{%- if details.get('default') is not none or details.get('default') == false %} Default: `{{ fmt_default(details.get('default', None)) | trim }}`.{% endif %}
{%- endmacro %}

{# Render a variable with sub-options using blockquotes for nesting #}
{% macro render_variable(name, details, depth=0) %}
{% set prefix = '> ' * depth %}
{% set desc = details.get('description', '') | trim %}
{% set meta_line = fmt_meta(details) | trim %}

{{ prefix }}{% if depth == 0 %}<a id="{{ name }}"></a>{% endif %}**{{ name }}** ({{ fmt_type(details) | trim }}) - {{ desc }}{% if meta_line %} {{ meta_line }}{% endif %}

{% if details.get('options') %}
{% for sub_name, sub_details in details['options'].items() %}
{{ render_variable(sub_name, sub_details, depth + 1) }}
{% endfor %}
{% endif %}
{%- endmacro %}

