---
profile: production
kinds:
  - yaml: "**/meta/collection-requirements.yml"
  - playbook: "**/tests/get_coverage.yml"
  - yaml: "**/tests/collection-requirements.yml"
  - playbook: "**/tests/tests_*.yml"
  - playbook: "**/tests/setup-snapshot.yml"
  - tasks: "**/tests/*.yml"
  - playbook: "**/tests/playbooks/*.yml"
  - tasks: "**/tests/tasks/*.yml"
  - tasks: "**/tests/tasks/*/*.yml"
  - vars: "**/tests/vars/*.yml"
  - playbook: "**/examples/*.yml"
skip_list:
  - fqcn-builtins
  - var-naming[no-role-prefix]
  # Temporary: the native `return:` key in meta/argument_specs.yml is not yet
  # accepted by the released ansible-lint role-arg-spec schema. Remove once
  # https://github.com/ansible/ansible-lint role-arg-spec.json supports it.
  # See https://github.com/ansible-community/antsibull-docs/issues/491.
  # (schema rules cannot be disabled with inline noqa, only via skip_list.)
  - schema[role-arg-spec]
exclude_paths:
  - tests/roles/
  - .github/
  - .markdownlint.yaml
  - examples/roles/
  - .collection/
mock_roles:
  - linux-system-roles.bootloader
supported_ansible_also:
  - "2.14.0"
